# ─────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TIMEZONE=Asia/Tashkent

# ─────────────────────────────────────────────
# DATABASE (Neon Postgres)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────
# REDIS (Upstash) — used by BullMQ + cache
# ─────────────────────────────────────────────
REDIS_URL="rediss://default:password@host:6379"

# ─────────────────────────────────────────────
# TELEGRAM BOT
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# Random long string you choose yourself — Telegram echoes it back on every
# webhook call in the X-Telegram-Bot-Api-Secret-Token header; we verify it.
TELEGRAM_WEBHOOK_SECRET="change-me-to-a-long-random-string"
# Public HTTPS base URL the bot is reachable at (used only by the
# set-webhook script, not read at runtime by the app itself).
PUBLIC_WEBHOOK_URL="https://your-domain.example.com"

# ─────────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────────
# Comma-separated Telegram numeric user IDs allowed to run /admin commands.
ADMIN_TELEGRAM_IDS="111111111,222222222"
# Reserved for the Daily Admin Report phase (not read yet in Phase 1).
DAILY_REPORT_TIME="20:00"

# ─────────────────────────────────────────────
# 4-CHANNEL ADAPTERS
# Telegram chat IDs (numeric, e.g. -1001234567890) for each channel the bot
# is an admin of. Leave a placeholder until the bot is actually added.
# ─────────────────────────────────────────────
CHANNEL_USTOZIMNURIM_CHAT_ID="-1001111111111"
CHANNEL_SAHIFALAR_CHAT_ID="-1002222222222"
CHANNEL_COMMUNITY_CHAT_ID="-1003333333333"
CHANNEL_QURANOY_CHAT_ID="-1004444444444"

# ─────────────────────────────────────────────
# ERROR MONITORING
# ─────────────────────────────────────────────
SENTRY_DSN=""
